#
# uci-defaults script - executed exactly once, on the first boot after the
# package has been installed. It makes sure the UCI configuration exists, that
# the init script is executable and that Simplified Chinese is offered in
# LuCI's language dropdown. Exiting with 0 makes the OpenWrt build system
# delete this script again, so it never runs twice.

[ -f /etc/config/ledset ] || touch /etc/config/ledset

if ! uci -q get ledset.global >/dev/null 2>&1; then
	uci -q set ledset.global=ledset
	uci -q set ledset.global.enable='1'
	uci -q commit ledset
fi

chmod 0755 /etc/init.d/ledset 2>/dev/null

# The Simplified Chinese catalog ships inside this package, but LuCI only
# offers a language in its dropdown once it is listed in luci.languages. That
# listing used to come from the separate luci-i18n-* package's own
# uci-defaults script, so it has to be done here now.
#
# Only set when absent: an existing entry (from luci-i18n-base-zh-cn, say) is
# left exactly as it is.
if ! uci -q get luci.languages.zh_cn >/dev/null 2>&1; then
	uci -q set luci.languages.zh_cn='简体中文 (Simplified Chinese)'
	uci -q commit luci
fi

exit 0
